# Public URL of the Free Win backend. Do not include a trailing slash.
PUBLIC_FREE_WIN_API_URL=http://127.0.0.1:8000
# Public URL of the Free Win card-search service. Do not include a trailing slash.
PUBLIC_FREE_WIN_SEARCH_URL=http://127.0.0.1:8001

# Docker Compose binds the client only to localhost.
FREE_WIN_CLIENT_PORT=4321
FREE_WIN_CLIENT_MEMORY_LIMIT=256m
FREE_WIN_CLIENT_CPU_LIMIT=0.5
FREE_WIN_CLIENT_PIDS_LIMIT=128
CLOUDFLARED_MEMORY_LIMIT=128m
CLOUDFLARED_CPU_LIMIT=0.5
CLOUDFLARED_PIDS_LIMIT=128

# Optional Cloudflare Tunnel profile. Keep empty when using only localhost.
CLOUDFLARED_TUNNEL_TOKEN=
