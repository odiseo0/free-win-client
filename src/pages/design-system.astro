---
import AppShell from '../components/layout/AppShell.astro'; import StateNotice from '../components/ui/StateNotice.svelte'; import '../styles/global.css';
if (!import.meta.env.DEV) return new Response('No encontrado', { status: 404 });
---
<AppShell title="Sistema de diseño | Free Win" layout="wide"><header><p class="route-label">DESARROLLO / COMPONENTES</p><h1 class="page-heading">Sistema de diseño</h1><p class="page-intro">Estados fijos para revisar el diseño, el acceso y las pantallas estrechas.</p></header><div class="gallery">
<section><h2>Acciones</h2><div class="row"><button class="button">Acción principal</button><button class="button-secondary">Acción secundaria</button><button class="text-action">Acción de texto</button><button class="button-danger">Eliminar registro</button><button class="button" disabled>Cargando…</button></div></section>
<section><h2>Campos</h2><div class="form-grid"><label><span class="label">Texto</span><input class="field" placeholder="Nombre del Pedido"/></label><label><span class="label">Correo</span><input class="field" type="email" value="persona@ejemplo.com"/></label><label><span class="label">Contraseña</span><input class="field" type="password" value="ejemplo"/></label><label><span class="label">Número</span><input class="field" type="number" value="999999"/></label><label><span class="label">Búsqueda</span><input class="field" type="search" value="Dragón Blanco de Ojos Azules"/><span class="field-hint">Busca por nombre o código.</span></label><label><span class="label">Fecha y hora</span><input class="field" type="datetime-local"/></label><label><span class="label">Con error</span><input class="field" aria-invalid="true" aria-describedby="sample-error"/><span id="sample-error" class="error-text">El servidor devolvió un mensaje de validación extenso.</span></label></div></section>
<section><h2>Estados</h2><div class="notices"><StateNotice client:load kind="loading" message="Consultando el catálogo…"/><StateNotice client:load message="No hay registros."/><StateNotice client:load kind="success" message="Los cambios se guardaron."/><StateNotice client:load kind="error" message="No pudimos guardar los cambios."/></div></section>
<section><p class="route-label">ORDEN / EN REVISIÓN</p><h2>Datos y totales</h2><div class="overflow-x-auto"><table><thead><tr><th>Carta</th><th>Cantidad</th><th>Total</th></tr></thead><tbody><tr><th>Nombre de carta muy largo para una pantalla estrecha</th><td>999</td><td>USD 99.999,99</td></tr></tbody></table></div><dl><div><dt>Cartas</dt><dd>USD 98.000,00</dd></div><div><dt>Impuesto</dt><dd>USD 1.999,99</dd></div><div class="total"><dt>Total</dt><dd>USD 99.999,99</dd></div></dl></section>
<section><h2>Más patrones</h2><details><summary>Fila de información <span aria-hidden="true">+</span></summary><p>Contenido de la fila abierta.</p></details><ol><li><strong>Orden aceptada</strong><br/><span class="route-label">09/09/2026 · USUARIO #3 · ACCEPTED</span></li></ol><div class="stepper" aria-label="Cantidad de carta"><button aria-label="Restar una copia">−</button><span>2</span><button aria-label="Añadir una copia">+</button></div><p class="route-label">BÚSQUEDA / PREPARANDO · INTENTO 2</p></section>
<section><h2>Shell de aplicación</h2><div class="shell-preview"><aside><strong>FREE WIN</strong><nav><a>Pedidos</a><a>Órdenes</a><a>Organizar</a></nav><p class="route-label">ACCESOS</p><a>Nueva Orden</a></aside><main><p class="status period-state">Pedido abierto</p><h3>Contenido centrado al 70 %</h3><p>El contenido usa el ancho de la pantalla y deja libre el menú.</p><footer>FREE WIN / COMUNIDAD DE YU-GI-OH! VENEZUELA</footer></main></div></section>
<section><h2>Navegación móvil</h2><div class="mobile-nav-samples"><div><p class="route-label">CERRADA</p><div class="mobile-bar-sample"><strong>FREE WIN</strong><span>•••</span></div></div><div><p class="route-label">ABIERTA</p><div class="drawer-sample"><strong>FREE WIN</strong><a>Pedidos</a><a>Órdenes</a><a>Organizar</a><span class="route-label">ACCESOS</span><a>Nueva Orden</a></div></div></div></section>
<section><h2>Cuenta</h2><div class="account-preview"><div><strong>FREE WIN</strong><h3>Entra a Free Win.</h3><label><span class="label">Correo</span><input class="field" type="email" value="persona@ejemplo.com"/></label></div><div class="art-safe-zone" aria-label="Espacio de arte con proporción cuatro por cinco"></div></div></section>
<section><h2>Acceso a la Orden actual</h2><div class="shortcut-samples"><div><p class="route-label">ORDEN ACTUAL</p><strong>ORDEN #31</strong><span>En revisión</span><a>Ver Orden</a></div><div><p class="route-label">ORDEN ACTUAL</p><strong>Sin Orden activa</strong><a>Crear una Orden</a></div><div><p class="route-label">ORDEN ACTUAL</p><strong>No disponible</strong><a>Consulta tus Órdenes</a></div></div></section>
<section><h2>Panel de Orden</h2><div class="progress-samples"><aside><p class="route-label">TU ORDEN</p><h3>Orden nueva</h3><p>Aún no has añadido cartas.</p></aside><aside><p class="route-label">TU ORDEN</p><h3>Orden #31</h3><div class="progress-row"><strong>Dark Magician</strong><strong>USD 0,79</strong><span>DPYG-EN001 · Rare · Near Mint</span><span>USD 0,79 · − 1 +</span></div><p class="error-text">No pudimos guardar una cantidad.</p></aside></div><div class="summary-sample"><div><p class="route-label">TU ORDEN</p><strong>2 cartas · USD 7,42</strong></div><button class="button-secondary">Ver Orden</button></div></section>
</div></AppShell><style>.gallery{display:grid;gap:7rem}.gallery h2{font:600 clamp(2rem,4vw,4rem)/1 var(--display);margin:0 0 2rem}.row{display:flex;gap:1rem;flex-wrap:wrap}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1.5rem;max-width:65rem}.notices{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:2rem}table{width:100%;border-collapse:collapse}th,td{padding:1rem;border-bottom:1px solid var(--ink);text-align:left}thead{font:600 .8125rem var(--mono);text-transform:uppercase}dl{max-width:34rem}dl div{display:flex;justify-content:space-between;gap:2rem}.total{font:600 1.5rem var(--display)}details{max-width:38rem;margin-bottom:2rem}summary{font:600 1.3rem var(--display);cursor:pointer}.stepper{display:inline-flex;border:2px solid var(--ink)}.stepper button,.stepper span{display:grid;min-width:44px;min-height:44px;place-items:center;border:0;background:transparent;color:var(--ink)}.stepper button+span,.stepper span+button{border-left:1px solid var(--ink)}</style>
<style>.shell-preview{--preview-nav-width:12rem;position:relative;min-height:28rem;border:1px solid var(--ink)}.shell-preview aside{position:absolute;inset:0 auto 0 0;display:grid;width:var(--preview-nav-width);align-content:start;gap:1rem;padding:1.5rem}.shell-preview nav{display:grid;gap:.5rem;margin:2rem 0}.shell-preview main{--preview-width:min(70%,calc(100% - var(--preview-nav-width) - 2rem));display:grid;width:var(--preview-width);min-height:28rem;margin-left:max(calc((100% - var(--preview-width))/2),calc(var(--preview-nav-width) + 1rem));padding:3rem 0}.shell-preview h3,.account-preview h3,.progress-samples h3{font:600 2rem/1 var(--display)}.shell-preview footer{align-self:end;margin-top:4rem;font:.7rem var(--mono)}.mobile-nav-samples,.shortcut-samples,.progress-samples{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:2rem}.mobile-bar-sample{display:flex;justify-content:space-between;border:1px solid var(--ink);padding:1rem}.drawer-sample{display:grid;min-height:22rem;align-content:start;gap:1rem;border:1px solid var(--ink);padding:1.5rem}.account-preview{display:grid;grid-template-columns:2fr 3fr;gap:3rem;align-items:center}.account-preview>div:first-child{display:grid;gap:1rem}.account-preview h3{white-space:nowrap}.art-safe-zone{width:min(100%,24rem);aspect-ratio:4/5;justify-self:end;background:var(--ink)}.shortcut-samples>div,.progress-samples aside{display:grid;align-content:start;gap:.5rem;border-left:1px solid var(--ink);padding:1.25rem}.shortcut-samples a{text-decoration:underline}.progress-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.35rem 1rem;padding-block:1rem;border-top:1px solid var(--ink);font-size:.75rem}.progress-row>*{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.progress-row>*:nth-child(even){text-align:right}.summary-sample{display:flex;max-width:30rem;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem;border:2px solid var(--ink);padding:.75rem}.summary-sample p{margin:0}@media(max-width:40rem){.shell-preview{min-height:0}.shell-preview aside{display:none}.shell-preview main{width:auto;min-height:0;margin:0;padding:2rem}.account-preview{grid-template-columns:1fr}.art-safe-zone{display:none}}</style>
<style>.gallery,.gallery>section,.row{min-width:0}</style>
