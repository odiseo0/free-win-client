---
import AccountLayout from '../components/layout/AccountLayout.astro';
import PersonaAccess from '../components/account/PersonaAccess.svelte';
import '../styles/global.css';

const returnTo = Astro.url.searchParams.get('returnTo') ?? '/order-periods';
---

<AccountLayout title="Únete a Free Win" description="Crea una cuenta para participar en los Pedidos de Free Win.">
	<header class="account-heading">
		<h1 id="account-title" class="account-title">Entra a Free Win.</h1>
		<p class="account-intro">Accede a los Pedidos de la comunidad.</p>
	</header>
		<PersonaAccess client:load {returnTo} />
</AccountLayout>
