---
import AppShell from '../../../components/layout/AppShell.astro';
import AdminOrderReview from '../../../components/workflow/AdminOrderReview.svelte';
import '../../../styles/global.css';

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/admin/orders');
---

<AppShell title={`Revisar orden #${id} | Free Win`}>
	<a class="mb-6 inline-flex text-sm text-stone-400 hover:text-stone-100" href="/admin/orders">
		← Volver a órdenes
	</a>
	<AdminOrderReview client:load id={id} />
</AppShell>
