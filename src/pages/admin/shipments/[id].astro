---
import AppShell from '../../../components/layout/AppShell.astro'; import ShipmentDetail from '../../../components/admin/ShipmentDetail.svelte'; import '../../../styles/global.css'; const id=Number(Astro.params.id); if(!Number.isInteger(id)||id<=0)return Astro.redirect('/admin/shipments');
---
<AppShell title={`Envío #${id} | Administración | Free Win`} layout="wide" area="admin"><a class="parent-link" href="/admin/shipments">← Volver a Envíos</a><ShipmentDetail client:load {id} /></AppShell>
