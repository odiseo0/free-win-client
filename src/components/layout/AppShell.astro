---
interface Props { title: string; description?: string; }
const { title, description = 'Free Win coordina Pedidos comunitarios de cartas Yu-Gi-Oh!.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
	{ href: '/order-periods', label: 'Pedidos', active: path.startsWith('/order-periods') },
	{ href: '/orders', label: 'Mis órdenes', active: path.startsWith('/orders') },
	{ href: '/admin/order-periods', label: 'Organizar', active: path.startsWith('/admin') },
	{ href: '/account', label: 'Cuenta', active: path.startsWith('/account') },
];
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#FFF8F0"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&family=Roboto:wght@400;500&display=swap" rel="stylesheet"/><title>{title}</title></head>
<body><a class="skip-link" href="#contenido">Ir al contenido</a><div class="task-shell"><header class="site-header task-header" data-header><a class="brand" href="/" aria-label="Free Win, inicio">FREE WIN</a><button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="task-menu" data-menu-toggle><span aria-hidden="true">•••</span></button><nav class="site-nav" id="task-menu" aria-label="Navegación principal" data-menu>{links.map(link=><a href={link.href} aria-current={link.active?'page':undefined}>{link.label}</a>)}</nav></header><main id="contenido" class="task-main"><slot/></main><footer class="task-footer"><img src="/assets/kaiba-footer.png" alt="" width="1254" height="1254" loading="lazy"/><p>FREE WIN / COMUNIDAD DE YU-GI-OH!</p><p>VENEZUELA</p></footer></div>
<script is:inline>const h=document.querySelector('[data-header]'),b=h?.querySelector('[data-menu-toggle]'),m=h?.querySelector('[data-menu]');const o=x=>{if(!b||!m)return;b.setAttribute('aria-expanded',String(x));b.setAttribute('aria-label',x?'Cerrar menú':'Abrir menú');m.dataset.open=String(x)};b?.addEventListener('click',()=>o(b.getAttribute('aria-expanded')!=='true'));m?.addEventListener('click',e=>{if(e.target.closest('a'))o(false)});document.addEventListener('click',e=>{if(b?.getAttribute('aria-expanded')==='true'&&!e.target.closest('[data-header]'))o(false)});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&b?.getAttribute('aria-expanded')==='true'){o(false);b.focus()}});matchMedia('(min-width:58.001rem)').addEventListener('change',e=>{if(e.matches)o(false)});</script></body></html>
