---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Free Win coordina Pedidos comunitarios de cartas Yu-Gi-Oh!." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
		<div class="min-h-screen">
			<header class="border-b border-slate-800 bg-slate-950/90">
				<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
					<a class="font-semibold tracking-tight text-white" href="/">Free Win</a>
					<nav aria-label="Navegación principal" class="flex gap-4 text-sm text-slate-400">
						<span>Pedidos</span><span>Mis órdenes</span><span>Cuenta</span>
					</nav>
				</div>
			</header>
			<main class="mx-auto max-w-6xl px-4 py-8 sm:px-6"><slot /></main>
		</div>
	</body>
</html>
