---
import AppNavigation from './AppNavigation.svelte';
import SessionGate from './SessionGate.svelte';

interface Props {
	title: string;
	description?: string;
	layout?: 'standard' | 'wide' | 'composer';
	area?: 'user' | 'admin';
}

const {
	title,
	description = 'Free Win coordina Pedidos comunitarios de cartas Yu-Gi-Oh!.',
	layout = 'standard',
	area = 'user',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#FFF8F0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Ir al contenido</a>
		<div class="app-shell">
			<AppNavigation client:load path={Astro.url.pathname} {area} />
			<div class="app-stage">
				<main id="contenido" class:list={['app-main', `app-main--${layout}`]}>
					<SessionGate client:load requiredPersona={area === 'admin' ? 'admin' : 'user'} path={Astro.url.pathname} />
					<slot />
				</main>
				<footer class:list={['task-footer', `task-footer--${layout}`]}>
					FREE WIN / COMUNIDAD DE YU-GI-OH! VENEZUELA
				</footer>
			</div>
		</div>
	</body>
</html>
